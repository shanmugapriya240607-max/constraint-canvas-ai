# Gemini Configuration
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Parser Mode: 'offline' (deterministic NLP fallback) or 'openai' (ChatGPT structured output)
PARSER_MODE=offline

# Database & CORS Configuration
DATABASE_URL=sqlite:///./data/constraint_canvas.db
FRONTEND_ORIGIN=http://localhost:5173
