# Public build-time value only. Never add Gemini/JWT secrets to VITE_ variables.
# Local development:
VITE_API_BASE_URL=http://127.0.0.1:8000
# On Vercel set this to the backend HTTPS origin (no /api suffix), then rebuild:
# VITE_API_BASE_URL=https://your-backend.onrender.com
# If unset, production uses same-origin paths; Vercel needs the explicit backend URL.
