# Blank values use local defaults. No external API key is required.
# SQLite relative paths resolve against backend/, regardless of working directory.
DATABASE_URL=
GEMINI_API_KEY=
# Optional comma-separated origins; blank enables common local React/Vite ports.
FRONTEND_ORIGINS=

# Production requires an environment-provided secret of at least 32 bytes.
# Generate locally: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Never commit the generated value. Without a key, development uses a random
# per-app key: restarting invalidates tokens; configure a key for multiple workers.
APP_ENV=development
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Structured extraction only; blank uses gemini-3.6-flash. Never put secrets here.
GEMINI_MODEL=
GEMINI_TIMEOUT_SECONDS=30

# Deployment (set these in the backend host dashboard, not in Git):
# APP_ENV=production
# DATABASE_URL=sqlite:////var/data/constraint_canvas.db
# FRONTEND_ORIGINS=https://your-frontend.vercel.app
# JWT_SECRET_KEY=<generate a random secret of at least 32 bytes>
# GEMINI_API_KEY=<server-side provider key>
# GEMINI_MODEL=gemini-3.6-flash
# PORT is injected by Render; start.py defaults to 8000 on other hosts.
# The public URL is only needed in frontend VITE_API_BASE_URL, not as a backend setting.
